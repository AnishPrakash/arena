# ---- Control plane ----
ARENA_HTTP_ADDR=:8080
ARENA_ENV=dev
ARENA_LOG_LEVEL=debug

# ---- Postgres ----
ARENA_PG_DSN=postgres://arena:arena@localhost:5432/arena?sslmode=disable
ARENA_PG_MAX_CONNS=20

# ---- Redis ----
ARENA_REDIS_ADDR=localhost:6379
ARENA_REDIS_DB=0

# ---- Auth ----
ARENA_JWT_SECRET=change-me-in-prod-32-bytes-minimum-please
ARENA_JWT_TTL=24h
ARENA_RUNNER_TOKEN=dev-runner-shared-secret-change-me

# ---- Queue ----
ARENA_STREAM=judge.jobs
ARENA_GROUP=judges
ARENA_LEASE_TTL=90s
ARENA_MAX_ATTEMPTS=3

# ---- Runner ----
ARENA_RUNNER_ID=runner-local-1
ARENA_RUNNER_SLOTS=4
ARENA_API_BASE=http://localhost:8080
ARENA_SANDBOX=docker
ARENA_BOX_ROOT=/var/tmp/arena-boxes
ARENA_CPUSET_BASE=1

# ---- Blob store ----
ARENA_BLOB_DRIVER=local
ARENA_BLOB_ROOT=/var/tmp/arena-blobs

# ---- Rate limits ----
ARENA_RL_SUBMIT_PER_MIN=12
ARENA_RL_BURST=4
