# Install on the host:
#   sudo cp deploy/arena.service /etc/systemd/system/
#   sudo sed -i "s|/home/USER/arena|$PWD|" /etc/systemd/system/arena.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now arena
[Unit]
Description=Arena judge stack
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/USER/arena
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
